<% var HOME_ID = 's5augclsPgKT'; var isHome = note.noteId === HOME_ID;

function collectRecommendNotes(parentNote, arr) {
    var children;
    try { children = parentNote.getChildNotes(); } catch(e) { return; }
    if (!children || !children.length) return;
    for (var i = 0; i < children.length; i++) {
        var child = children[i];
        if (child.type === 'text' && child.hasLabel && child.hasLabel('recommend') && child.getLabelValue('recommend') === 'true') {
            arr.push(child);
        }
        if (child.hasVisibleChildren && child.hasVisibleChildren()) {
            collectRecommendNotes(child, arr);
        }
    }
}

function collectLatestByLabel(parentNote, labelName, arr) {
    var children;
    try { children = parentNote.getChildNotes(); } catch(e) { return; }
    if (!children || !children.length) return;
    for (var i = 0; i < children.length; i++) {
        var child = children[i];
        if (child.type === 'text' && child.hasLabel && child.hasLabel(labelName) && child.getLabelValue(labelName) === 'true') {
            arr.push(child);
        }
        if (child.hasVisibleChildren && child.hasVisibleChildren()) {
            collectLatestByLabel(child, labelName, arr);
        }
    }
}

function extractNoteContent(n) {
    var data = { date: '', summary: '' };
    try {
        var raw = '';
        if (typeof n.getContent === 'function') { raw = n.getContent(); }
        else if (n.content) { raw = n.content; }
        if (typeof raw === 'string' && raw) {
            var txt = raw.replace(/<[^>]*>/g, '').replace(/&[^;]+;/g, ' ').replace(/\s+/g, ' ').trim();
            data.summary = txt.substring(0, 80);
            if (txt.length > 80) data.summary += '…';
        }
    } catch(e) {}
    try {
        var dateSrc = n.dateCreated || n.utcDateCreated || n.utcDateModified || n.dateModified;
        if (dateSrc) {
            var d = typeof dateSrc.getTime === 'function' ? dateSrc : new Date(dateSrc);
            if (!isNaN(d.getTime())) {
                data.date = d.getFullYear() + '-' +
                    String(d.getMonth() + 1).padStart(2, '0') + '-' +
                    String(d.getDate()).padStart(2, '0') + ' ' +
                    String(d.getHours()).padStart(2, '0') + ':' +
                    String(d.getMinutes()).padStart(2, '0') + ':' +
                    String(d.getSeconds()).padStart(2, '0');
            }
        }
    } catch(e) {}
    return data;
}

var articleNote = null;
var articleDate = '';
var articleSummary = '';
try {
    var recNotes = [];
    if (isHome) { collectRecommendNotes(note, recNotes); }
    if (recNotes.length > 0) {
        articleNote = recNotes[Math.floor(Math.random() * recNotes.length)];
        var ad = extractNoteContent(articleNote);
        articleDate = ad.date;
        articleSummary = ad.summary;
    }
} catch(e) { articleNote = null; }

var latestNote = null;
var latestDate = '';
var latestSummary = '';
try {
    var artNotes = [];
    if (isHome) { collectLatestByLabel(note, 'article', artNotes); }
    if (artNotes.length > 0) {
        artNotes.sort(function (a, b) {
            var da = a.dateCreated || a.utcDateCreated || a.utcDateModified || a.dateModified || '';
            var db = b.dateCreated || b.utcDateCreated || b.utcDateModified || b.dateModified || '';
            return da > db ? -1 : da < db ? 1 : 0;
        });
        latestNote = artNotes[0];
        var ld = extractNoteContent(latestNote);
        latestDate = ld.date;
        latestSummary = ld.summary;
    }
} catch(e) { latestNote = null; }

var updates = [];
try {
    var updNotes = [];
    if (isHome) { collectLatestByLabel(note, 'recentUpdate', updNotes); }
    if (updNotes.length > 0) {
        updNotes.sort(function (a, b) {
            var da = '', db = '';
            try { da = a.getLabelValue('dateNote') || a.utcDateModified || a.dateModified || ''; } catch(e) { da = a.utcDateModified || a.dateModified || ''; }
            try { db = b.getLabelValue('dateNote') || b.utcDateModified || b.dateModified || ''; } catch(e) { db = b.utcDateModified || b.dateModified || ''; }
            return da > db ? -1 : da < db ? 1 : 0;
        });
        for (var ui = 0; ui < updNotes.length && updates.length < 3; ui++) {
            var n = updNotes[ui];
            var ud = extractNoteContent(n);
            var dnote = '';
            try { dnote = n.getLabelValue('dateNote') || ''; } catch(e) {}
            updates.push({ note: n, date: dnote || ud.date, summary: ud.summary });
        }
    }
} catch(e) {}
%>

<header class="top-bar">
    <div class="top-inner">
        <img class="top-avatar" src="/share/logo.icon" alt="" />
        <div class="top-info">
            <span class="top-name">子非鱼</span>
            <span class="top-subtitle">流水不腐，户枢不蠹。</span>
        </div>
        <nav class="top-nav">
            <a class="nav-item<% if (isHome) { %> active<% } %>" href="<%= HOME_ID %>">首页</a>
            <a class="nav-item category-btn" id="category-btn" href="#">分类</a>
            <a class="nav-item" href="#">关于</a>
        </nav>
        <button class="icon-btn" id="theme-toggle" aria-label="切换主题">☀</button>
        <button class="icon-btn menu-btn" id="menu-toggle" aria-label="菜单">☰</button>
    </div>
</header>

<div class="mobile-menu" id="mobile-menu">
    <nav class="mobile-nav">
        <a class="nav-item<% if (isHome) { %> active<% } %>" href="<%= HOME_ID %>">首页</a>
        <a class="nav-item" id="category-btn-mobile" href="#">分类</a>
        <a class="nav-item" href="#">关于</a>
    </nav>
</div>

<div class="category-panel" id="category-panel">
    <div class="category-tags" id="category-tags">
        <ul class="tree-list" id="tree-list"></ul>
    </div>
</div>

<div class="page">
    <% if (isHome) { %>
    <main class="grid-4">
        <div class="mod mod-rec">
            <div class="mod-header-rec">
                <div class="mod-icon mod-icon--rec">📕</div>
                <h3 class="mod-title mod-title--rec">推荐阅读</h3>
            </div>
            <div class="rec-card" id="rec-card">
                <% if (articleNote) { %>
                    <% if (articleDate) { %><time class="rec-date"><%= articleDate %></time><% } %>
                    <h4 class="rec-title"><a href="/share/<%= articleNote.noteId %>"><%= articleNote.title %></a></h4>
                    <% if (articleSummary) { %><p class="rec-summary"><%= articleSummary %></p><% } %>
                <% } else { %>
                    <div class="rec-empty">暂无推荐</div>
                <% } %>
            </div>
        </div>
        <div class="mod mod-rec">
            <div class="mod-header-rec">
                <div class="mod-icon mod-icon--rec">📰</div>
                <h3 class="mod-title mod-title--rec">最近发布</h3>
            </div>

            <div class="rec-card">
                <% if (latestNote) { %>
                    <% if (latestDate) { %><time class="rec-date"><%= latestDate %></time><% } %>
                    <h4 class="rec-title"><a href="/share/<%= latestNote.noteId %>"><%= latestNote.title %></a></h4>
                    <% if (latestSummary) { %><p class="rec-summary"><%= latestSummary %></p><% } %>
                <% } else { %>
                    <div class="rec-empty">暂无文章</div>
                <% } %>
            </div>
        </div>
        <div class="mod mod-rec">
            <div class="mod-header-rec">
                <div class="mod-icon mod-icon--rec">⚡</div>
                <h3 class="mod-title mod-title--rec">最近动态</h3>
            </div>
            <div class="rec-card">
                <% if (updates.length > 0) {
                    for (var ui = 0; ui < updates.length; ui++) {
                        var u = updates[ui]; %>
                    <div class="rec-upd-item">
                        <time class="rec-date"><%= u.date %></time>
                        <h4 class="rec-title"><a href="/share/<%= u.note.noteId %>"><%= u.note.title %></a></h4>
                    </div>
                <% } } else { %>
                    <div class="rec-empty">暂无动态</div>
                <% } %>
            </div>
        </div>
        <div class="mod">
            <div class="mod-icon">🔗</div>
            <h3 class="mod-title">模块四</h3>
            <p class="mod-desc">友链互换</p>
        </div>
        <div class="mod">
            <div class="mod-icon">📌</div>
            <h3 class="mod-title">模块五</h3>
            <p class="mod-desc">近期动态 / 公告</p>
        </div>
    </main>
    <% } else { %>
    <main class="note-content">
        <div class="note-layout">
            <article class="mod" data-created="<%= note.dateCreated %>" data-modified="<%= note.dateModified %>">
                <h1 class="note-title"><%= note.title %></h1>
                <div class="note-body">
                    <%- content %>
                </div>
            </article>
            <aside class="toc" id="toc">
                <div class="toc-header">
                    <span class="toc-title">目录</span>
                </div>
                <nav class="toc-body" id="toc-body"></nav>
            </aside>
        </div>
    </main>
    <% } %>

    <footer class="site-footer">
        <span>© 2026 brucevon.space</span>
        <span>已运行 <strong id="run-days">--</strong> 天</span>
        <a class="beian-wrap"
            href="http://www.beian.gov.cn/portal/registerSystemInfo?recordcode=52230102000497"
            target="_blank" rel="noopener">
            <img class="beian-icon" src="/share/beian.png" alt="" aria-hidden="true" />
            贵公网安备52230102000497号</a>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">黔ICP备2026006103号-1</a>
        <a href="https://github.com/TriliumNext/Trilium" target="_blank" rel="noopener">Powered by TriliumNext</a>
    </footer>
</div>

<script>
// 主题切换同步 highlight.js 样式
(function () {
    function syncHljsTheme() {
        var isDark = document.documentElement.getAttribute("data-theme") === "dark";
        var darkLink  = document.getElementById("hljs-theme-dark");
        var lightLink = document.getElementById("hljs-theme-light");
        if (darkLink)  darkLink.disabled  = !isDark;
        if (lightLink) lightLink.disabled = isDark;
    }
    syncHljsTheme();
    // 观察主题属性变化
    var observer = new MutationObserver(syncHljsTheme);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
})();
</script>

<script src="/share/blog.js" defer></script>
