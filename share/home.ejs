<% var HOME_ID = 's5augclsPgKT'; var isHome = note.noteId === HOME_ID;

function collectRecommendNotes(parentNote, arr) {
    var children;
    try { children = parentNote.getChildNotes(); } catch(e) { return; }
    if (!children || !children.length) return;
    for (var i = 0; i < children.length; i++) {
        var child = children[i];
        if (child.type === 'text' && child.hasLabel && child.hasLabel('recommend') && child.getLabelValue('recommend') === 'true') {
            arr.push(child);
        }
        if (child.hasVisibleChildren && child.hasVisibleChildren()) {
            collectRecommendNotes(child, arr);
        }
    }
}

var articleNote = null;
var articleDate = '';
var articleSummary = '';
try {
    var articleNotes = [];
    if (isHome) { collectRecommendNotes(note, articleNotes); }
    if (articleNotes.length > 0) {
        articleNote = articleNotes[Math.floor(Math.random() * articleNotes.length)];
        /* 内容摘要 */
        try {
            var raw = '';
            if (typeof articleNote.getContent === 'function') { raw = articleNote.getContent(); }
            else if (articleNote.content) { raw = articleNote.content; }
            if (typeof raw === 'string' && raw) {
                var txt = raw.replace(/<[^>]*>/g, '').replace(/&[^;]+;/g, ' ').replace(/\s+/g, ' ').trim();
                articleSummary = txt.substring(0, 80);
                if (txt.length > 80) articleSummary += '…';
            }
        } catch(e) {}
        /* 创建时间 */
        try {
            var dateStr = articleNote.utcDateCreated || articleNote.dateCreated || articleNote.utcDateModified || articleNote.dateModified || '';
            if (dateStr) {
                var d = new Date(dateStr);
                if (!isNaN(d.getTime())) {
                    articleDate = d.getFullYear() + '-' +
                        String(d.getMonth() + 1).padStart(2, '0') + '-' +
                        String(d.getDate()).padStart(2, '0') + ' ' +
                        String(d.getHours()).padStart(2, '0') + ':' +
                        String(d.getMinutes()).padStart(2, '0') + ':' +
                        String(d.getSeconds()).padStart(2, '0');
                }
            }
        } catch(e) {}
    }
} catch(e) {
    articleNote = null;
}
%>

