<% var _ogTitle = isHome ? (_cfg.blogTitle || 'Bento Blog') : note.title;var _ogDesc = _pageDesc;if (!_ogDesc) { try { var _raw = (typeof content === 'string') ? content : '';_ogDesc = _raw.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/\s+/g, ' ').trim();if (_ogDesc.length > 160) _ogDesc = _ogDesc.substring(0, 160) + '…';} catch(_e) { _ogDesc = '';} } var _ogImage = '';if (!isHome) { try { var _raw2 = (typeof content === 'string') ? content : '';var _imgMatch = _raw2.match(/<img[^>]+src=["']([^"']+)["']/i);if (_imgMatch) _ogImage = _imgMatch[1];} catch(_e) {} } if (!_ogImage) _ogImage = _cfg.defaultCover || '';var _ogUrl = '/' + note.noteId;var _ogType = isHome ? 'website' : 'article';var _twCard = _ogImage ? 'summary_large_image' : 'summary'; %>
