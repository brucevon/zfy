<link rel="stylesheet" href="/blog.css" />
<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />

<%
// -- 标签化主页检测 --
var HOME_ID = '';
var homeNote = null;
try {
    var _cur = note;
    for (var _d = 0; _d < 50; _d++) {
        if (_cur.hasLabel && _cur.hasLabel('isHome') && _cur.getLabelValue('isHome') === 'true') {
            homeNote = _cur;
            HOME_ID = _cur.noteId;
            break;
        }
        var _parents = _cur.getParentNotes();
        if (!_parents || !_parents.length) break;
        _cur = _parents[0];
    }
} catch(_e) {}
var isHome = note.noteId === HOME_ID;

// -- 从主页读取全局配置 --
var _cfg = {};
if (homeNote) {
    function _cfgVal(name, def) {
        try { var v = homeNote.getLabelValue(name); return v || def; } catch(_) { return def; }
    }
    _cfg.homeId = HOME_ID;
    _cfg.isHome = isHome;
    _cfg.defaultTheme = _cfgVal('appearanceDefaultTheme', 'dark');
    _cfg.twikooEnabled = _cfgVal('twikooEnabled') === 'true';
    _cfg.twikooEnvId = _cfgVal('twikooEnvId', '');
    _cfg.defaultCover = _cfgVal('coverDefaultImage', '/bg-pc.png');
    _cfg.coverMobileImage = _cfgVal('coverMobileImage', '/bg-mobile.png');
    _cfg.blogTitle = _cfgVal('blogTitle', '');
    _cfg.blogDescription = _cfgVal('blogDescription', '');
    _cfg.footerCopyright = _cfgVal('footerCopyright', '');
    _cfg.footerIcp = _cfgVal('footerIcp', '');
    _cfg.footerPolice = _cfgVal('footerPolice', '');
    _cfg.footerPoliceUrl = _cfgVal('footerPoliceUrl', '');
    _cfg.footerBeianIcon = _cfgVal('footerBeianIcon', '/beian.png');
    _cfg.siteStartDate = _cfgVal('siteStartDate', '');
    _cfg.twikooVersion = _cfgVal('twikooVersion', '1.6.41');
    _cfg.tagCloudIconClass = _cfgVal('tagCloudIconClass', 'bx bx-purchase-tag-alt');
    // -- 自动检测标签云笔记 --
    _cfg.tagCloudNoteId = '';
    try {
        if (note.hasLabel && note.hasLabel('tagCloud')) {
            _cfg.tagCloudNoteId = note.noteId;
            try { var _tci = note.getLabelValue('tagCloudIconClass'); if (_tci) _cfg.tagCloudIconClass = _tci; } catch(_e) {}
        } else if (homeNote) {
            var _kids = homeNote.getChildNotes();
            if (_kids) for (var _k = 0; _k < _kids.length; _k++) {
                if (_kids[_k].hasLabel && _kids[_k].hasLabel('tagCloud')) {
                    _cfg.tagCloudNoteId = _kids[_k].noteId;
                    break;
                }
            }
        }
    } catch(_e) {}
    _cfg.statTags = {
        recommend: _cfgVal('statTagRecommend', '推荐阅读'),
        article: _cfgVal('statTagArticle', '文章'),
        recentUpdate: _cfgVal('statTagUpdate', '动态'),
        announcement: _cfgVal('statTagAnnounce', '公告')
    };
}

// -- 当前笔记图标 --
var _noteIconCls = '';
try { _noteIconCls = note.getLabelValue('icon') || note.getLabelValue('iconClass') || ''; } catch(_e) {}
if (_noteIconCls) _cfg.noteIcon = _noteIconCls;
var _pageDesc = '';
try { _pageDesc = note.getLabelValue('blogDescription') || _cfg.blogDescription || ''; } catch(_e) { _pageDesc = _cfg.blogDescription || ''; }
%>
<title><%= _cfg.blogTitle || 'Bento Blog' %><%= isHome ? ' - 首页' : ' - ' + note.title %></title>

<script>window.__BLOG_CONFIG__ = <%- JSON.stringify(_cfg) %>;</script>
<style>
  :root {
    --cover-pc: url("<%= _cfg.defaultCover %>");
    --cover-mobile: url("<%= _cfg.coverMobileImage %>");
  }
</style>

<div class="page<%= isHome ? ' page--home' : '' %>">

<header class="header">
  <div class="header-inner">
    <div class="logo-area">
      <img class="logo-icon" src="/logo.icon" alt="" />
      <span class="logo-text"><%= _cfg.blogTitle || 'ZFY' %></span>
    </div>

    <nav class="nav-links">
      <a class="nav-item<%= isHome ? ' active' : '' %>" href="./">首页</a>
      <a class="nav-item category-btn" id="category-btn" href="#">分类</a>
      <div class="nav-item-wrap" id="about-wrap">
        <a class="nav-item" href="#" id="about-btn">关于</a>
        <div class="about-dropdown" id="about-dropdown">
          <ul class="about-menu" id="about-menu"></ul>
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <button class="btn-icon" id="search-toggle" aria-label="搜索"><i class="bx bx-search"></i></button>
      <button class="btn-icon" id="theme-toggle" aria-label="切换主题">☀</button>
      <button class="hamburger" id="menu-toggle" aria-label="菜单">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="search-dropdown" id="search-dropdown">
    <div class="search-inner">
        <input class="search-input" id="search-input" type="text" placeholder="搜索笔记标题或内容…" autocomplete="off" spellcheck="false" />
        <div class="search-results" id="search-results"></div>
    </div>
</div>

<div class="mobile-menu" id="mobile-menu">
  <a class="nav-item<%= isHome ? ' active' : '' %>" href="./">首页</a>
  <a class="nav-item category-btn" id="category-btn-mobile" href="#">分类</a>
  <a class="nav-item" id="about-btn-mobile" href="#">关于</a>
  <div class="about-dropdown about-dropdown--mobile" id="about-dropdown-mobile">
    <ul class="about-menu" id="about-menu-mobile"></ul>
  </div>
</div>

<div class="category-panel" id="category-panel">
    <div class="cat-mega" id="cat-mega">
        <div class="cat-mega-inner">
            <!-- 左侧：分类树 -->
            <div class="cat-mega-left">
                <div class="cat-mega-label">分类</div>
                <ul class="tree-list" id="tree-list"></ul>
            </div>
            <!-- 右侧：统计简报 + 最近更新 -->
            <div class="cat-mega-right">
                <div class="cat-mega-section">
                    <div class="cat-mega-label">统计</div>
                    <div class="cat-mega-stats">
                        <span class="cat-stat-item">文章 <em id="cms-article">-</em></span>
                        <span class="cat-stat-item">动态 <em id="cms-update">-</em></span>
                        <span class="cat-stat-item">推荐 <em id="cms-recommend">-</em></span>
                        <span class="cat-stat-item">公告 <em id="cms-announce">-</em></span>
                    </div>
                </div>
                <div class="cat-mega-section">
                    <div class="cat-mega-label">最近动态</div>
                    <ul class="cat-mega-updates" id="cms-updates"></ul>
                </div>
            </div>
        </div>
    </div>
</div>

    <% if (isHome) {
        function _tagListUrl(tag) {
            if (!_cfg.tagCloudNoteId || !tag) return '#';
            return '/' + _cfg.tagCloudNoteId + '?tag=' + encodeURIComponent(tag);
        }
        var _st = _cfg.statTags || { recommend: '推荐阅读', article: '文章', recentUpdate: '动态', announcement: '公告' };
        var _statLink = !!_cfg.tagCloudNoteId;
    %>
<div class="layout">
  <aside class="sidebar-col">
    <div class="panel">
      <div class="panel-header">📢 公告</div>
      <div class="panel-body">
        <div class="notice-list" id="mod-announcement"></div>
      </div>
    </div>
    <div class="panel">
      <div class="panel-header">⚡ 动态</div>
      <div class="panel-body">
        <div class="notice-list" id="mod-updates"></div>
      </div>
    </div>
    <div class="panel">
      <div class="panel-header">📅 更新热力</div>
      <div class="panel-body">
        <div class="hm-wrap" id="mod-heatmap">
          <div class="hm-grid" id="heatmap-grid"></div>
        </div>
      </div>
    </div>
  </aside>
  <main class="main-col">
    <div class="section-header">
      <div class="section-title"><span class="icon">📝</span>最新文章</div>
      <% if (_cfg.tagCloudNoteId) { %>
      <a class="section-more" href="/<%= _cfg.tagCloudNoteId %>">查看全部 →</a>
      <% } %>
    </div>
    <div class="article-panel">
      <div class="article-list" id="mod-article"></div>
    </div>
  </main>
</div>
    <% } else if (note.hasLabel && note.hasLabel('tagCloud')) { %>
    <div id="tagCloudPage"><%- content %></div>
    <% } else { %>
    <!-- highlight.js 代码高亮（仅文章页加载） -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" id="hljs-theme-dark" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css" id="hljs-theme-light" disabled />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/bash.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/python.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/javascript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/typescript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/go.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/rust.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/yaml.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/json.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/sql.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/dockerfile.min.js"></script>
    <script>
    (function () {
        function syncHljsTheme() {
            var isDark = document.documentElement.getAttribute("data-theme") === "dark";
            var darkLink  = document.getElementById("hljs-theme-dark");
            var lightLink = document.getElementById("hljs-theme-light");
            if (darkLink)  darkLink.disabled  = !isDark;
            if (lightLink) lightLink.disabled = isDark;
        }
        syncHljsTheme();
        var observer = new MutationObserver(syncHljsTheme);
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    })();
    </script>
    <div id="reading-progress"></div>
    <main class="note-content">
        <div class="note-layout">
            <article class="mod" data-created="<%= note.dateCreated %>" data-modified="<%= note.dateModified %>">
                <h1 class="note-title"<% try { var _noteC = note.getLabelValue('color'); if (_noteC) { %> style="color:<%= _noteC %>"<% } } catch(_e){} %>><% if (_noteIconCls) { %><i class="<%= _noteIconCls %>"></i> <% } %><%= note.title %><button class="share-btn" aria-label="分享链接" title="复制链接"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg></button></h1>
                <div class="note-meta"></div>
                <div class="note-body">
                    <%- content.replace(/<img /g, '<img loading="lazy" ') %>
                </div>
            </article>
            <aside class="toc" id="toc">
                <div class="toc-header">
                    <span class="toc-title">目录</span>
                </div>
                <nav class="toc-body" id="toc-body"></nav>
            </aside>
        </div>
    </main>
    <% } %>

    <%
    // Twikoo: 全局启用 + 每笔记单独开启
    var _enableTwikoo = false;
    try {
        if (!isHome && _cfg.twikooEnabled && note.hasLabel && note.hasLabel('enableTwikoo')) {
            _enableTwikoo = (note.getLabelValue('enableTwikoo') === 'true');
        }
    } catch(_e) {}
    if (_enableTwikoo) { %>
    <div id="tcomment"></div>
<script src="https://cdn.jsdelivr.net/npm/twikoo@<%= _cfg.twikooVersion %>/dist/twikoo.all.min.js"></script>
<script>
(function () {
    var opts = {
        el: '#tcomment',
        path: '<%= note.noteId %>',
        lang: 'zh-CN'
    };
    <% if (_cfg.twikooEnvId) { %>opts.envId = '<%= _cfg.twikooEnvId %>';<% } %>

    twikoo.init(opts);

    /* 同步评论框主题 */
    function syncTheme() {
        var c = document.getElementById('twikoo-container');
        if (!c) return;
        c.setAttribute('data-theme', document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
    }
    new MutationObserver(syncTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
})();
</script>
    <% } %>

    <footer class="footer">
        <div class="footer-divider">
            <% if (_cfg.footerCopyright) { %><span><%= _cfg.footerCopyright %></span> · <% } %>
            <% if (_cfg.footerPolice) { %>
            <a href="<%= _cfg.footerPoliceUrl || '#' %>" target="_blank" rel="noopener"><%= _cfg.footerPolice %></a> ·
            <% } %>
            <% if (_cfg.footerIcp) { %>
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener"><%= _cfg.footerIcp %></a> ·
            <% } %>
            <a href="https://github.com/TriliumNext/Trilium" target="_blank" rel="noopener">Powered by TriliumNext</a>
            · 已运行 <strong id="run-days">--</strong> 天
        </div>
    </footer>
</div>

<script>
// 热力图 tooltip
(function () {
    var hmTip = null;
    var hmActiveCell = null;
    var isMobile = ('ontouchstart' in window) || (window.innerWidth <= 768);

    function hmDismiss() {
        if (hmTip) { hmTip.remove(); hmTip = null; }
        if (hmActiveCell) { hmActiveCell.classList.remove('active'); hmActiveCell = null; }
    }

    function showTip(cell) {
        if (hmTip) hmDismiss();
        var date = cell.getAttribute('data-date');
        var count = parseInt(cell.getAttribute('data-count')) || 0;
        var text = date + (count > 0 ? '：更新了 ' + count + ' 个文件' : '：无更新');
        var tip = document.createElement('div');
        tip.className = 'hm-tip';
        tip.textContent = text;
        document.body.appendChild(tip);
        var rect = cell.getBoundingClientRect();
        var tipW = tip.offsetWidth;
        var tipH = tip.offsetHeight;
        var margin = 8;
        var left = rect.left + rect.width / 2;
        var top = rect.top - margin;
        if (left - tipW / 2 < margin) left = margin + tipW / 2;
        if (left + tipW / 2 > window.innerWidth - margin) left = window.innerWidth - margin - tipW / 2;
        if (top - tipH < margin) top = rect.bottom + margin;
        tip.style.left = (left - tipW / 2) + 'px';
        tip.style.top = (top - tipH) + 'px';
        hmTip = tip;
        hmActiveCell = cell;
        if (cell) { cell.classList.add('active'); }
    }

    function hmListen(grid) {
        grid.addEventListener('mouseover', function (e) {
            if (isMobile) return;
            var cell = e.target.closest('.hm-cell');
            if (!cell) { hmDismiss(); return; }
            showTip(cell);
        });
        grid.addEventListener('mouseleave', function () {
            if (isMobile) return;
            hmDismiss();
        });
        grid.addEventListener('click', function (e) {
            var cell = e.target.closest('.hm-cell');
            if (!cell) return;
            if (hmActiveCell === cell) { hmDismiss(); return; }
            showTip(cell);
        });
        var scrollEl = document.querySelector('.page') || window;
        scrollEl.addEventListener('scroll', hmDismiss, { passive: true });
    }

    var hmObs = new MutationObserver(function () {
        var grid = document.getElementById('heatmap-grid');
        if (grid && grid.children.length > 0) {
            hmObs.disconnect();
            hmListen(grid);
        }
    });
    var hmTarget = document.getElementById('mod-heatmap');
    if (hmTarget) hmObs.observe(hmTarget, { childList: true, subtree: true });
})();
</script>
<script src="/blog.js" defer></script>