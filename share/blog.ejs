        var _u = SSR.updates[_ui];
%>
          <div class="rec-upd-item"><% if (_u.icon) { %><i class="<%= _u.icon %> upd-item-icon"></i> <% } %><time class="rec-date"><%= _ymd(_u.dateCreated) %></time><h4 class="rec-title"><a href="<%= _url(_u) %>"<% if (_u.color) { %> style="color:<%= _esc(_u.color) %>"<% } %><%= _u.ext ? ' target="_blank" rel="noopener"' : '' %>><%= _u.title %></a></h4><% if (_u.tags && _u.tags.length) { %><div class="module-tags"><% for (var _u2=0;_u2<_u.tags.length;_u2++){ %><span class="tag-chip tag-chip--note" data-tag="<%= _esc(_u.tags[_u2]) %>" style="<%= _tagStyle(_u.tags[_u2]) %>"><i class="bx bx-purchase-tag-alt"></i> <%= _esc(_u.tags[_u2]) %></span><% } %></div><% } %></div>
<%
      } if (!SSR.updates.length) {
%>
          <div class="rec-empty">暂无动态</div>
<% } %>
        </div>
      </div>
    </div>
    <div class="panel">
      <div class="panel-header">📅 更新热力</div>
      <div class="panel-body">
        <div class="hm-wrap" id="mod-heatmap" data-ssr="home">
          <div class="hm-grid" id="heatmap-grid" style="<%- SSR.hmGridStyle %>"><%- SSR.hmHTML %></div>
        </div>
        <script>document.addEventListener('DOMContentLoaded',function(){var w=document.querySelector('.hm-wrap');if(w)w.scrollLeft=w.scrollWidth-w.clientWidth;});</script>
      </div>
    </div>
  </aside>
  <main class="main-col">
    <div class="section-header">
      <div class="section-title"><span class="icon">📝</span>最新文章</div>
      <% if (_cfg.tagCloudNoteId) { %>
      <a class="section-more" href="/<%= _cfg.tagCloudNoteId %>">查看全部 →</a>
      <% } %>
    </div>
    <div class="article-panel">
      <div class="article-list" id="mod-article" data-ssr="home">
<%
      var _pageSize = 5;
      for (var _ai = 0; _ai < Math.min(_pageSize, SSR.articles.length); _ai++) {
        var _a = SSR.articles[_ai];
%>
        <div class="article-mod<% if (_a.cover) { %> article-mod--has-cover<% } %>"<% if (_a.cover) { %> style="--cover-url:url('<%= _esc(_a.cover) %>')"<% } %>><%- _card(_a, 'rec-card-body--wide') %></div>
<%
      } if (!SSR.articles.length) {
%>
        <div class="rec-empty">暂无文章</div>
<% } %>
      </div>
<% if (SSR.articles.length > _pageSize) { %><nav class="article-pager" id="article-pager"></nav><% } %>
    </div>
  </main>
</div>
