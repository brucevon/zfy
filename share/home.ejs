<%
// -- 标签化主页检测 --
var HOME_ID = '';
var homeNote = null;
try {
    var _cur = note;
    for (var _d = 0; _d < 50; _d++) {
        if (_cur.hasLabel && _cur.hasLabel('isHome') && _cur.getLabelValue('isHome') === 'true') {
            homeNote = _cur;
            HOME_ID = _cur.noteId;
            break;
        }
        var _parents = _cur.getParentNotes();
        if (!_parents || !_parents.length) break;
        _cur = _parents[0];
    }
} catch(_e) {}
var isHome = note.noteId === HOME_ID;

// -- 从主页读取全局配置 --
var _cfg = {};
if (homeNote) {
    function _cfgVal(name, def) {
        try { var v = homeNote.getLabelValue(name); return v || def; } catch(_) { return def; }
    }
    _cfg.homeId = HOME_ID;
    _cfg.defaultTheme = _cfgVal('appearanceDefaultTheme', 'dark');
    _cfg.twikooEnabled = _cfgVal('twikooEnabled') === 'true';
    _cfg.twikooEnvId = _cfgVal('twikooEnvId', '');
    _cfg.defaultCover = _cfgVal('coverDefaultImage', '/bg-pc.png');
    _cfg.coverMobileImage = _cfgVal('coverMobileImage', '/bg-mobile.png');
    _cfg.blogTitle = _cfgVal('blogTitle', '');
    _cfg.blogDescription = _cfgVal('blogDescription', '');
    _cfg.footerCopyright = _cfgVal('footerCopyright', '');
    _cfg.footerIcp = _cfgVal('footerIcp', '');
    _cfg.footerPolice = _cfgVal('footerPolice', '');
    _cfg.footerPoliceUrl = _cfgVal('footerPoliceUrl', '');
    _cfg.footerBeianIcon = _cfgVal('footerBeianIcon', '/beian.png');
    _cfg.siteStartDate = _cfgVal('siteStartDate', '');
    _cfg.twikooVersion = _cfgVal('twikooVersion', '1.6.41');
}
%>
<title><%= _cfg.blogTitle || 'Bento Blog' %></title>

<%
function collectRecommendNotes(parentNote, arr, _depth) {
    if (_depth === undefined) _depth = 0;
    if (_depth > 20) return;
    var children;
    try { children = parentNote.getChildNotes(); } catch(e) { return; }
    if (!children || !children.length) return;
    for (var i = 0; i < children.length; i++) {
        var child = children[i];
        if (child.type === 'text' && child.hasLabel && child.hasLabel('recommend') && child.getLabelValue('recommend') === 'true') {
            arr.push(child);
        }
        if (child.hasVisibleChildren && child.hasVisibleChildren()) {
            collectRecommendNotes(child, arr, _depth + 1);
        }
    }
}

function collectLatestByLabel(parentNote, labelName, arr, _depth) {
    if (_depth === undefined) _depth = 0;
    if (_depth > 20) return;
    var children;
    try { children = parentNote.getChildNotes(); } catch(e) { return; }
    if (!children || !children.length) return;
    for (var i = 0; i < children.length; i++) {
        var child = children[i];
        try {
            var hasIt = false;
            if (child.hasLabel && child.hasLabel(labelName)) { hasIt = true; }
            else if (child.getLabelValue) {
                try { var _v = child.getLabelValue(labelName); hasIt = (_v !== null && _v !== undefined); } catch(_){}
            }
            if (hasIt) {
                var lv = child.getLabelValue ? child.getLabelValue(labelName) : '';
                if (lv !== 'false') { arr.push(child); }
            }
        } catch(e) {}
        try {
            var gc = child.getChildNotes ? child.getChildNotes() : null;
            if (gc && gc.length) { collectLatestByLabel(child, labelName, arr, _depth + 1); }
        } catch(e) {}
    }
}

function extractNoteContent(n) {
    var data = { date: '', summary: '' };
    try {
        var raw = '';
        if (typeof n.getContent === 'function') { raw = n.getContent(); }
        else if (n.content) { raw = n.content; }
        if (typeof raw === 'string' && raw) {
            var txt = raw.replace(/<[^>]*>/g, '').replace(/&[^;]+;/g, ' ').replace(/\s+/g, ' ').trim();
            data.summary = txt.substring(0, 80);
            if (txt.length > 80) data.summary += '…';
        }
    } catch(e) {}
    try {
        var dateSrc = n.dateCreated || n.utcDateCreated || n.utcDateModified || n.dateModified;
        if (dateSrc) {
            var d = typeof dateSrc.getTime === 'function' ? dateSrc : new Date(dateSrc);
            if (!isNaN(d.getTime())) {
                data.date = d.getFullYear() + '-' +
                    String(d.getMonth() + 1).padStart(2, '0') + '-' +
                    String(d.getDate()).padStart(2, '0') + ' ' +
                    String(d.getHours()).padStart(2, '0') + ':' +
                    String(d.getMinutes()).padStart(2, '0') + ':' +
                    String(d.getSeconds()).padStart(2, '0');
            }
        }
    } catch(e) {}
    return data;
}

var articleNote = null;
var articleDate = '';
var articleSummary = '';
try {
    var recNotes = [];
    if (isHome) { collectRecommendNotes(note, recNotes); }
    if (recNotes.length > 0) {
        articleNote = recNotes[Math.floor(Math.random() * recNotes.length)];
        var ad = extractNoteContent(articleNote);
        articleDate = ad.date;
        articleSummary = ad.summary;
    }
} catch(e) { articleNote = null; }

var latestNote = null;
var latestDate = '';
var latestSummary = '';
try {
    var artNotes = [];
    if (isHome) { collectLatestByLabel(note, 'article', artNotes); }
    if (artNotes.length > 0) {
        artNotes.sort(function (a, b) {
            var da = a.dateCreated || a.utcDateCreated || a.utcDateModified || a.dateModified || '';
            var db = b.dateCreated || b.utcDateCreated || b.utcDateModified || b.dateModified || '';
            return da > db ? -1 : da < db ? 1 : 0;
        });
        latestNote = artNotes[0];
        var ld = extractNoteContent(latestNote);
        latestDate = ld.date;
        latestSummary = ld.summary;
    }
} catch(e) { latestNote = null; }

var updates = [];
try {
    var updNotes = [];
    try { collectLatestByLabel(note, 'recentUpdate', updNotes); } catch(e) {}
    if (updNotes.length > 0) {
        updNotes.sort(function (a, b) {
            var da = '', db = '';
            try { da = a.getLabelValue('dateNote') || a.utcDateModified || a.dateModified || ''; } catch(e) { da = a.utcDateModified || a.dateModified || ''; }
            try { db = b.getLabelValue('dateNote') || b.utcDateModified || b.dateModified || ''; } catch(e) { db = b.utcDateModified || b.dateModified || ''; }
            return da > db ? -1 : da < db ? 1 : 0;
        });
        for (var ui = 0; ui < updNotes.length && updates.length < 3; ui++) {
            var n = updNotes[ui];
            var ud = extractNoteContent(n);
            var dnote = '';
            try { dnote = n.getLabelValue('dateNote') || ''; } catch(e) {}
            updates.push({ note: n, date: dnote || ud.date, summary: ud.summary });
        }
    }
} catch(e) {}

var annNote = null;
var annDate = '';
var annSummary = '';
try {
    var annNotes = [];
    if (isHome) { collectLatestByLabel(note, 'announcement', annNotes); }
    if (annNotes.length > 0) {
        annNotes.sort(function (a, b) {
            var da = a.dateCreated || a.utcDateCreated || a.utcDateModified || a.dateModified || '';
            var db = b.dateCreated || b.utcDateCreated || b.utcDateModified || b.dateModified || '';
            return da > db ? -1 : da < db ? 1 : 0;
        });
        annNote = annNotes[0];
        var ad = extractNoteContent(annNote);
        annDate = ad.date;
        annSummary = ad.summary;
    }
} catch(e) { annNote = null; }

// ── 热力图数据 ──
// SQL: SELECT date, COUNT(*) AS total FROM (
//   SELECT noteId, SUBSTR(dateModified,0,11) AS date FROM notes
//   UNION
//   SELECT DISTINCT noteId, SUBSTR(dateCreated,0,11) AS date FROM revisions
// ) GROUP BY date
// 优先使用 api.sql 查询整个服务端，回退到子树遍历
var dateFreq = {};
var hmWeeks = [];
var hmMonths = [];
var hmMax = 1;
try {
    if (typeof api !== 'undefined' && api.sql) {
        var sqlRows = api.sql.execute("SELECT date, COUNT(*) AS total FROM (SELECT noteId, SUBSTR(dateModified,0,11) AS date FROM notes UNION SELECT DISTINCT noteId, SUBSTR(dateCreated,0,11) AS date FROM revisions) GROUP BY date");
        if (sqlRows && sqlRows.length) {
            for (var ri = 0; ri < sqlRows.length; ri++) {
                dateFreq[sqlRows[ri].date] = parseInt(sqlRows[ri].total, 10);
            }
        }
    } else {
        (function collectDates(n) {
            var dsMod = n.utcDateModified || n.dateModified || '';
            if (dsMod) {
                var d = new Date(dsMod);
                if (!isNaN(d.getTime())) {
                    var key = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
                    dateFreq[key] = (dateFreq[key] || 0) + 1;
                }
            }
            var dsCre = n.utcDateCreated || n.dateCreated || '';
            if (dsCre) {
                var dc = new Date(dsCre);
                if (!isNaN(dc.getTime())) {
                    var key = dc.getFullYear() + '-' + String(dc.getMonth()+1).padStart(2,'0') + '-' + String(dc.getDate()).padStart(2,'0');
                    dateFreq[key] = (dateFreq[key] || 0) + 1;
                }
            }
            var kids;
            try { kids = n.getChildNotes(); } catch(e) { return; }
            if (!kids || !kids.length) return;
            for (var i = 0; i < kids.length; i++) {
                collectDates(kids[i]);
            }
        })(note);
    }
    // 计算 hmMax
    for (var dk in dateFreq) {
        if (dateFreq[dk] > hmMax) hmMax = dateFreq[dk];
    }

    var now = new Date();
    now.setHours(0, 0, 0, 0);
    var start = new Date(now);
    start.setDate(start.getDate() - 363);
    while (start.getDay() !== 1) { start.setDate(start.getDate() - 1); }

    var cur = new Date(start);
    var prevMonth = -1;
    var monthStart = -1;

    while (cur <= now) {
        if (cur.getMonth() !== prevMonth) {
            if (prevMonth !== -1) {
                hmMonths.push({ label: (prevMonth + 1) + '月', start: monthStart, span: hmWeeks.length - monthStart });
            }
            prevMonth = cur.getMonth();
            monthStart = hmWeeks.length;
        }
        var week = [];
        for (var d = 0; d < 7; d++) {
            var key = cur.getFullYear() + '-' + String(cur.getMonth()+1).padStart(2,'0') + '-' + String(cur.getDate()).padStart(2,'0');
            week.push({ date: key, count: dateFreq[key] || 0 });
            cur.setDate(cur.getDate() + 1);
        }
        hmWeeks.push(week);
    }
    if (prevMonth !== -1) {
        hmMonths.push({ label: (prevMonth + 1) + '月', start: monthStart, span: hmWeeks.length - monthStart });
    }

    for (var wi = 0; wi < hmWeeks.length; wi++) {
        for (var di = 0; di < 7; di++) {
            if (hmWeeks[wi][di].count > hmMax) hmMax = hmWeeks[wi][di].count;
        }
    }
} catch(e) {}
%>

