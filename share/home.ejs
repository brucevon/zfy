<div class="page">
    <% if (isHome) { %>
    <main class="grid-4">
        <div class="mod mod-rec">
            <div class="mod-header-rec">
                <div class="mod-icon mod-icon--rec">📕</div>
                <h3 class="mod-title mod-title--rec">推荐阅读</h3>
            </div>
            <div class="rec-card" id="rec-card">
                <% if (articleNote) { %>
                    <% if (articleDate) { %><time class="rec-date"><%= articleDate %></time><% } %>
                    <h4 class="rec-title"><a href="/<%= articleNote.noteId %>"><%= articleNote.title %></a></h4>
                    <% if (articleSummary) { %><p class="rec-summary"><%= articleSummary %></p><% } %>
                <% } else { %>
                    <div class="rec-empty">暂无推荐</div>
                <% } %>
            </div>
        </div>
        <div class="mod mod-rec">
            <div class="mod-header-rec">
                <div class="mod-icon mod-icon--rec">📰</div>
                <h3 class="mod-title mod-title--rec">最近发布</h3>
            </div>

            <div class="rec-card">
                <% if (latestNote) { %>
                    <% if (latestDate) { %><time class="rec-date"><%= latestDate %></time><% } %>
                    <h4 class="rec-title"><a href="/<%= latestNote.noteId %>"><%= latestNote.title %></a></h4>
                    <% if (latestSummary) { %><p class="rec-summary"><%= latestSummary %></p><% } %>
                <% } else { %>
                    <div class="rec-empty">暂无文章</div>
                <% } %>
            </div>
        </div>
        <div class="mod mod-rec">
            <div class="mod-header-rec">
                <div class="mod-icon mod-icon--rec">⚡</div>
                <h3 class="mod-title mod-title--rec">最近动态</h3>
            </div>
            <div class="rec-card">
                <% if (updates.length > 0) {
                    for (var ui = 0; ui < updates.length; ui++) {
                        var u = updates[ui]; %>
                    <div class="rec-upd-item">
                        <time class="rec-date"><%= u.date %></time>
                        <h4 class="rec-title"><a href="/<%= u.note.noteId %>"><%= u.note.title %></a></h4>
                    </div>
                <% } } else { %>
                    <div class="rec-empty">暂无动态</div>
                <% } %>
            </div>
        </div>
        <div class="mod mod-rec">
            <div class="mod-header-rec">
                <div class="mod-icon mod-icon--rec">📣</div>
                <h3 class="mod-title mod-title--rec">公告</h3>
            </div>
            <div class="rec-card">
                <% if (annNote) { %>
                    <time class="rec-date"><%= annDate %></time>
                    <h4 class="rec-title"><a href="/<%= annNote.noteId %>"><%= annNote.title %></a></h4>
                <% } else { %>
                    <div class="rec-empty">暂无公告</div>
                <% } %>
            </div>
        </div>
        <div class="mod mod-stats">
            <div class="mod-header-stats">
                <div class="mod-icon">📊</div>
                <h3 class="mod-title">统计摘要</h3>
            </div>
            <div class="stats-row">
                <span class="stats-item">推荐阅读 <em><%= (typeof recNotes !== 'undefined' ? recNotes : [null]).length %></em></span>
                <span class="stats-item">最近发布 <em><%= (typeof artNotes !== 'undefined' ? artNotes : [null]).length %></em></span>
                <span class="stats-item">最近动态 <em><%= (typeof updNotes !== 'undefined' ? updNotes : [null]).length %></em></span>
                <span class="stats-item">公告 <em><%= (typeof annNotes !== 'undefined' ? annNotes : [null]).length %></em></span>
            </div>
            <div class="hm-wrap">
                <div class="hm-grid" style="grid-template-columns: 28px repeat(<%= hmWeeks.length %>, 13px); grid-template-rows: 18px repeat(7, 13px);">
                    <% for (var mi = 0; mi < hmMonths.length; mi++) { var m = hmMonths[mi]; %>
                        <div class="hm-month" style="grid-column: <%= 2 + m.start %> / span <%= m.span %>; grid-row: 1"><%= m.label %></div>
                    <% } %>
                    <% var wdays = ['一','二','三','四','五','六','日']; %>
                    <% for (var di = 0; di < 7; di++) { %>
                        <div class="hm-wday" style="grid-column: 1; grid-row: <%= di + 2 %>"><%= wdays[di] %></div>
                        <% for (var wi = 0; wi < hmWeeks.length; wi++) {
                            var cell = hmWeeks[wi][di];
                            var level = 0;
                            if (cell.count > 0) { level = Math.ceil((cell.count / hmMax) * 4); if (level < 1) level = 1; if (level > 4) level = 4; }
                        %>
                            <div class="hm-cell hm-l<%= level %>" style="grid-column: <%= wi + 2 %>; grid-row: <%= di + 2 %>" data-date="<%= cell.date %>" data-count="<%= cell.count %>" title="<%= cell.date %>: <%= cell.count > 0 ? '更新了 ' + cell.count + ' 个文件' : '无更新' %>"></div>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
    <% } else { %>
    <main class="note-content">
        <div class="note-layout">
            <article class="mod" data-created="<%= note.dateCreated %>" data-modified="<%= note.dateModified %>">
