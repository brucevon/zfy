<div class="page<%= isHome ? ' page--home' : '' %>">

<header class="header">
  <div class="header-inner">
    <div class="logo-area">
      <img class="logo-icon" src="/logo.icon" alt="" />
      <span class="logo-text"><%= _cfg.blogTitle || 'ZFY' %></span>
    </div>

    <nav class="nav-links">
      <a class="nav-item<%= isHome ? ' active' : '' %>" href="./">首页</a>
      <a class="nav-item category-btn" id="category-btn" href="#">分类</a>
      <div class="nav-item-wrap" id="about-wrap">
        <a class="nav-item" href="#" id="about-btn">关于</a>
        <div class="about-dropdown" id="about-dropdown">
          <ul class="about-menu" id="about-menu"></ul>
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <button class="btn-icon" id="search-toggle" aria-label="搜索"><i class="bx bx-search"></i></button>
      <button class="btn-icon" id="theme-toggle" aria-label="切换主题">☀</button>
      <button class="hamburger" id="menu-toggle" aria-label="菜单">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="search-dropdown" id="search-dropdown">
    <div class="search-inner">
        <div class="search-input-wrap">
            <span class="search-input-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
            <input class="search-input" id="search-input" type="text" placeholder="搜索笔记标题或内容…" autocomplete="off" spellcheck="false" />
        </div>
        <div class="search-results" id="search-results"></div>
    </div>
</div>

<div class="mobile-menu" id="mobile-menu">
  <a class="nav-item<%= isHome ? ' active' : '' %>" href="./">首页</a>
  <a class="nav-item category-btn" id="category-btn-mobile" href="#">分类</a>
  <a class="nav-item" id="about-btn-mobile" href="#">关于</a>
  <div class="about-dropdown about-dropdown--mobile" id="about-dropdown-mobile">
    <ul class="about-menu" id="about-menu-mobile"></ul>
  </div>
</div>

<div class="category-panel" id="category-panel">
    <div class="cat-mega" id="cat-mega">
        <div class="cat-mega-inner">
            <!-- 左侧：分类树 -->
            <div class="cat-mega-left">
                <div class="cat-mega-label">分类</div>
                <ul class="tree-list" id="tree-list"></ul>
            </div>
            <!-- 右侧：统计简报 + 最近更新 -->
            <div class="cat-mega-right">
                <div class="cat-mega-section">
                    <div class="cat-mega-label">统计</div>
                    <div class="cat-mega-stats stats-dashboard">
                        <a class="stat-pill stat-pill--article<%= _statLink ? '' : ' stat-pill--static' %>" href="<%= _tagListUrl(_st.article) %>" title="查看文章列表">
                            <i class="bx bx-news stat-pill__icon"></i>
                            <span class="stat-pill__label">文章</span>
                            <em class="stat-pill__num" id="cms-article">--</em>
                        </a>
                        <a class="stat-pill stat-pill--update<%= _statLink ? '' : ' stat-pill--static' %>" href="<%= _tagListUrl(_st.recentUpdate) %>" title="查看动态">
                            <i class="bx bx-time-five stat-pill__icon"></i>
                            <span class="stat-pill__label">动态</span>
                            <em class="stat-pill__num" id="cms-update">--</em>
                        </a>
                        <a class="stat-pill stat-pill--recommend<%= _statLink ? '' : ' stat-pill--static' %>" href="<%= _tagListUrl(_st.recommend) %>" title="查看推荐阅读">
                            <i class="bx bx-star stat-pill__icon"></i>
                            <span class="stat-pill__label">推荐</span>
                            <em class="stat-pill__num" id="cms-recommend">--</em>
                        </a>
                        <a class="stat-pill stat-pill--announce<%= _statLink ? '' : ' stat-pill--static' %>" href="<%= _tagListUrl(_st.announcement) %>" title="查看公告">
                            <i class="bx bx-bell stat-pill__icon"></i>
                            <span class="stat-pill__label">公告</span>
                            <em class="stat-pill__num" id="cms-announce">--</em>
                        </a>
                    </div>
                </div>
                <div class="cat-mega-section">
                    <div class="cat-mega-label">最近动态</div>
                    <ul class="cat-mega-updates" id="cms-updates"></ul>
                </div>
            </div>
        </div>
    </div>
</div>

