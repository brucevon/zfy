<link rel="stylesheet" href="/blog.css" />
<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />

<%
// -- 标签化主页检测 --
var HOME_ID = '';
var homeNote = null;
try {
    var _cur = note;
    for (var _d = 0; _d < 50; _d++) {
        if (_cur.hasLabel && _cur.hasLabel('isHome') && _cur.getLabelValue('isHome') === 'true') {
            homeNote = _cur;
            HOME_ID = _cur.noteId;
            break;
        }
        var _parents = _cur.getParentNotes();
        if (!_parents || !_parents.length) break;
        _cur = _parents[0];
    }
} catch(_e) {}
var isHome = note.noteId === HOME_ID;

// -- 从主页读取全局配置 --
var _cfg = {};
if (homeNote) {
    function _cfgVal(name, def) {
        try { var v = homeNote.getLabelValue(name); return v || def; } catch(_) { return def; }
    }
    _cfg.homeId = HOME_ID;
    _cfg.isHome = isHome;
    _cfg.defaultTheme = _cfgVal('appearanceDefaultTheme', 'dark');
    _cfg.twikooEnabled = _cfgVal('twikooEnabled') === 'true';
    _cfg.twikooEnvId = _cfgVal('twikooEnvId', '');
    _cfg.defaultCover = _cfgVal('coverDefaultImage', '/bg-pc.png');
    _cfg.coverMobileImage = _cfgVal('coverMobileImage', '/bg-mobile.png');
    _cfg.blogTitle = _cfgVal('blogTitle', '');
    _cfg.blogDescription = _cfgVal('blogDescription', '');
    _cfg.footerCopyright = _cfgVal('footerCopyright', '');
    _cfg.footerIcp = _cfgVal('footerIcp', '');
    _cfg.footerPolice = _cfgVal('footerPolice', '');
    _cfg.footerPoliceUrl = _cfgVal('footerPoliceUrl', '');
    _cfg.footerBeianIcon = _cfgVal('footerBeianIcon', '/beian.png');
    _cfg.siteStartDate = _cfgVal('siteStartDate', '');
    _cfg.twikooVersion = _cfgVal('twikooVersion', '1.6.41');
    _cfg.tagCloudIconClass = _cfgVal('tagCloudIconClass', 'bx bx-purchase-tag-alt');
    // -- 自动检测标签云笔记 --
    _cfg.tagCloudNoteId = '';
    try {
        if (note.hasLabel && note.hasLabel('tagCloud')) {
            _cfg.tagCloudNoteId = note.noteId;
            try { var _tci = note.getLabelValue('tagCloudIconClass'); if (_tci) _cfg.tagCloudIconClass = _tci; } catch(_e) {}
        } else if (homeNote) {
            var _kids = homeNote.getChildNotes();
            if (_kids) for (var _k = 0; _k < _kids.length; _k++) {
                if (_kids[_k].hasLabel && _kids[_k].hasLabel('tagCloud')) {
                    _cfg.tagCloudNoteId = _kids[_k].noteId;
                    break;
                }
            }
        }
    } catch(_e) {}
    _cfg.statTags = {
        recommend: _cfgVal('statTagRecommend', '推荐阅读'),
        article: _cfgVal('statTagArticle', '文章'),
        recentUpdate: _cfgVal('statTagUpdate', '动态'),
        announcement: _cfgVal('statTagAnnounce', '公告')
    };
}

// -- 当前笔记图标 --
var _noteIconCls = '';
try { _noteIconCls = note.getLabelValue('icon') || note.getLabelValue('iconClass') || ''; } catch(_e) {}
if (_noteIconCls) _cfg.noteIcon = _noteIconCls;
var _pageDesc = '';
try { _pageDesc = note.getLabelValue('blogDescription') || _cfg.blogDescription || ''; } catch(_e) { _pageDesc = _cfg.blogDescription || ''; }

// -- 站点统计点击跳转（分类菜单/首页通用） --
function _tagListUrl(tag) {
    if (!_cfg.tagCloudNoteId || !tag) return '#';
    return '/' + _cfg.tagCloudNoteId + '?tag=' + encodeURIComponent(tag);
}
var _st = _cfg.statTags || { recommend: '推荐阅读', article: '文章', recentUpdate: '动态', announcement: '公告' };
var _statLink = !!_cfg.tagCloudNoteId;
%>
<title><%= _cfg.blogTitle || 'Bento Blog' %><%= isHome ? ' - 首页' : ' - ' + note.title %></title>
<%
// -- Meta/OG 标签 --
var _ogTitle = isHome ? (_cfg.blogTitle || 'Bento Blog') : note.title;
var _ogDesc = _pageDesc;
if (!_ogDesc) {
    try {
        var _raw = (typeof content === 'string') ? content : '';
        _ogDesc = _raw.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/\s+/g, ' ').trim();
        if (_ogDesc.length > 160) _ogDesc = _ogDesc.substring(0, 160) + '…';
    } catch(_e) { _ogDesc = ''; }
}
var _ogImage = '';
if (!isHome) {
    try {
        var _raw2 = (typeof content === 'string') ? content : '';
        var _imgMatch = _raw2.match(/<img[^>]+src=["']([^"']+)["']/i);
        if (_imgMatch) _ogImage = _imgMatch[1];
    } catch(_e) {}
}
if (!_ogImage) _ogImage = _cfg.defaultCover || '';
var _ogUrl = '/' + note.noteId;
var _ogType = isHome ? 'website' : 'article';
var _twCard = _ogImage ? 'summary_large_image' : 'summary';
%>
<meta property="og:title" content="<%= _ogTitle %>">
<meta property="og:description" content="<%= _ogDesc %>">
<meta property="og:type" content="<%= _ogType %>">
<meta property="og:url" content="<%= _ogUrl %>">
<% if (_ogImage) { %><meta property="og:image" content="<%= _ogImage %>"><% } %>
<meta name="description" content="<%= _ogDesc %>">
<meta name="twitter:card" content="<%= _twCard %>">
<meta name="twitter:title" content="<%= _ogTitle %>">
<meta name="twitter:description" content="<%= _ogDesc %>">
<% if (_ogImage) { %><meta name="twitter:image" content="<%= _ogImage %>"><% } %>

<script>window.__BLOG_CONFIG__ = <%- JSON.stringify(_cfg).replace(/<\/script/gi, '<\\/script') %>;</script>
<style>
  :root {
    --cover-pc: url("<%= _cfg.defaultCover %>");
    --cover-mobile: url("<%= _cfg.coverMobileImage %>");
  }
</style>

<div class="page<%= isHome ? ' page--home' : '' %>">

<% 
// ── 服务端实时聚合：分类树 + 关于菜单 + 右侧统计/动态（所有页面头部共用） ──
// 由服务端实时遍历笔记树生成，取代浏览器 fetch(/blog-data)。
// 遍历起点 = homeNote || subRoot（分享根），跳过体根自身与 #shareHiddenFromTree。
var _SSR_TREE = '', _SSR_ABOUT = '';
var _SSR_STATS = { article:0, recentUpdate:0, recommend:0, announcement:0 };
var _SSR_MEGA_UPDATES = '';
var _SSR_TAGDATA = {};    // noteTag 标签索引 { name: { count, noteId:[...] } }（自包含 SSR，供标签云）
var _SSR_HUB = [];        // 枢纽笔记（含 noteTag/article 等）：标签云文章列表源
var _SSR_SEARCH = [];     // 标题索引（可见的非分类笔记）：前端标题搜索，无需 /blog-search 快照
var _SSR_TAGJSON = '{}', _SSR_HUBJSON = '[]', _SSR_SEARCHJSON = '[]';
var _SSR_CATPATH = {};   // noteId → 分类祖先路径 [{noteId,title}]（面包屑用）
// 封面兜底：优先 #articleCover，缺失时取文章正文首张图片；再无图片则空（不显示封面）。
function _blogFirstImg(html){ if(!html) return ''; try{ var m=String(html).match(/<img[^>]+src=["']([^"']+)["']/i); return m?m[1]:''; }catch(e){ return ''; } }
function _blogCover(n){
  if(!n) return '';
  try{ var c = n.getLabelValue ? (n.getLabelValue('articleCover')||'') : ''; if(c) return c; }catch(e){}
  var html='';
  try{ if(typeof n.getContent==='function'){ var r=n.getContent(); if(typeof r==='string') html=r; } }catch(e){}
  if(!html){ try{ if(typeof n.content==='string') html=n.content; }catch(e){} }
  return _blogFirstImg(html);
}
/* 创建时间：优先级 = 预处理写入的 #dateCreated 标签 → note 字段 → fetchNote(noteId) 取完整笔记 */
var _blogCreatedCache = {}; /* 每次渲染进程内缓存，避免重复取 */
function _blogCreated(n){
  if(!n || !n.noteId) return '';
  if(_blogCreatedCache[n.noteId] !== undefined) return _blogCreatedCache[n.noteId];
  try{ var L = n.getLabelValue ? (n.getLabelValue('dateCreated')||'') : ''; if(L){ return _blogCreatedCache[n.noteId]=L; } }catch(e){}
  try{ var c = n.utcDateCreated || n.dateCreated; if(c){ return _blogCreatedCache[n.noteId]=c; } }catch(e){}
  try{ if(typeof fetchNote === 'function'){ var f = fetchNote(n.noteId); if(f){ var c2 = f.utcDateCreated || f.dateCreated; if(c2){ return _blogCreatedCache[n.noteId]=c2; } } } }catch(e){}
  return _blogCreatedCache[n.noteId] = '';
}
(function(){
  function _escT(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&#34;').replace(/'/g,'&#39;'); }
  function _lbl(n,name){ try{ return n.getLabelValue ? (n.getLabelValue(name)||'') : ''; }catch(e){ return ''; } }
  /* 仅统计“笔记自身拥有”的标签（避免从根/分类继承导致 #recommend=true 覆盖所有笔记） */
  function _has(n,name){ try{ var _at=n.ownedAttributes; if(_at){ for(var _i2=0;_i2<_at.length;_i2++){ var _aa=_at[_i2]; if(_aa && _aa.type==='label' && _aa.name===name){ var _vv=_aa.value; if(_vv===undefined||_vv===null||_vv===''||_vv==='true') return true; } } return false; } }catch(e){} try{ return n.hasLabel ? !!n.hasLabel(name) : (_lbl(n,name)!==''); }catch(e2){ return false; } }
  function _kids(n){ try{ return n.getChildNotes(); }catch(e){ return null; } }
  function _ymdH(v){ if(!v) return ''; try{ var o=new Date(v); if(!isNaN(o.getTime())) return o.getFullYear()+'-'+String(o.getMonth()+1).padStart(2,'0')+'-'+String(o.getDate()).padStart(2,'0'); }catch(e){} return String(v).slice(0,10); }
  // 读取某笔记所有 #noteTag 值（ownedAttributes 遍历，兼容多个 noteTag）
  function _noteTags(n){
    var arr=[];
    try{
      var attrs=n.ownedAttributes;
      if(attrs) for(var i=0;i<attrs.length;i++){ var a=attrs[i]; if(a && a.type==='label' && a.name==='noteTag' && a.value) arr.push(a.value); }
    }catch(e){}
    if(!arr.length){ var v=_lbl(n,'noteTag'); if(v) arr=[v]; }
    return arr;
  }
  function _megaLi(n, dateStr){
    var ext=_lbl(n,'shareExternalLink'), icon=_lbl(n,'icon')||_lbl(n,'iconClass'), color=_lbl(n,'color'), alias=_lbl(n,'shareAlias');
    var href = ext ? ext : ('/'+(alias||n.noteId));
    var st = color ? ' style="color:'+_escT(color)+'"' : '';
    var s='<li class="cat-mega-update-item">';
    if(icon) s+='<i class="'+_escT(icon)+'"></i> ';
    s+='<a href="'+_escT(href)+'"'+(ext?' target="_blank" rel="noopener"':'')+st+'>'+_escT(n.title||'')+'</a>';
    s+='<time>'+_escT(_ymdH(dateStr))+'</time></li>';
    return s;
  }
  // 遍历计数：同步收集统计与"最近动态"。动态先全量收集，遍历后按时间倒序取前 3（与首页模块一致）
  var _UPD_ARR = [];
  function _count(n){
    var a=_has(n,'article'), u=_has(n,'recentUpdate'), r=_has(n,'recommend'), an=_has(n,'announcement');
    if(a) _SSR_STATS.article++;
    if(u) _SSR_STATS.recentUpdate++;
    // 推荐统计与首页底部计数器口径一致：计所有带 #recommend 的笔记数
    if(r) _SSR_STATS.recommend++;
    if(an) _SSR_STATS.announcement++;
    if(u && n.title) _UPD_ARR.push({ n:n, d:_blogCreated(n)||n.utcDateModified||n.dateCreated||'' });
    // 标签索引 + 枢纽笔记
    if(n.title){
      var tg=_noteTags(n);
      if(tg.length){
        for(var t=0;t<tg.length;t++){
          var ti=_SSR_TAGDATA[tg[t]] || (_SSR_TAGDATA[tg[t]]={count:0,noteId:[]});
          if(ti.noteId.indexOf(n.noteId)===-1){ ti.noteId.push(n.noteId); ti.count++; }
        }
        _SSR_HUB.push({ noteId:n.noteId, title:n.title, noteIcon:_lbl(n,'icon')||_lbl(n,'iconClass')||'', color:_lbl(n,'color')||'',
          shareAlias:_lbl(n,'shareAlias')||'', shareExternalLink:_lbl(n,'shareExternalLink')||'',
          cover:_blogCover(n),
          dateCreated:_blogCreated(n)||n.utcDateModified||'', dateModified:n.utcDateModified||n.dateModified||'', tags:tg });
      }
    }
  }
  // 全量遍历（含 #shareHiddenFromTree 隐藏节点 + 去重）：收集统计、最近动态、标签云、分类路径。
  function _countWalk(n, seen, cpath){
    if(!n || !n.noteId) return;
    if(seen[n.noteId]) return;
    seen[n.noteId]=true;
    var cp = cpath || [];
    if(_lbl(n,'category')==='true') cp = cp.concat([{ noteId:n.noteId, title:n.title||'' }]);
    _SSR_CATPATH[n.noteId] = cp;
    // 标题索引：收集可见的"内容笔记"（非分类、非隐藏），供前端标题搜索
    if(n.title && _lbl(n,'shareHiddenFromTree')!=='true' && _lbl(n,'category')!=='true'){
      _SSR_SEARCH.push({ noteId:n.noteId, title:n.title, shareAlias:_lbl(n,'shareAlias')||'',
        shareExternalLink:_lbl(n,'shareExternalLink')||'', noteIcon:_lbl(n,'icon')||_lbl(n,'iconClass')||'',
        color:_lbl(n,'color')||'', cat:cp });
    }
    _count(n);
    var k=_kids(n);
    if(k) for(var i=0;i<k.length;i++) _countWalk(k[i], seen, cp);
  }
  function _build(parent, skipId){
    var out='', k=_kids(parent); if(!k) return out;
    for(var i=0;i<k.length;i++){
      var n=k[i]; if(!n||!n.noteId) continue;
      if(n.noteId===skipId) continue;
      if(_lbl(n,'shareHiddenFromTree')==='true') continue;
      var ext=_lbl(n,'shareExternalLink'), cat=_lbl(n,'category')==='true';
      var isArt=_lbl(n,'article')==='true'; // 具体文章，其子笔记为附加内容（如封面），不在菜单展开
      var icon=_lbl(n,'icon')||_lbl(n,'iconClass'), color=_lbl(n,'color'), alias=_lbl(n,'shareAlias');
      var nk=_kids(n), hasKids=!!(nk&&nk.length) && !isArt;
      if(isArt) nk=null; // 文章不再展开子内容
      var st = color ? ' style="color:'+_escT(color)+'"' : '';
      var openT, closeT;
      if(ext){ openT='<a class="tag-chip" href="'+_escT(ext)+'" target="_blank" rel="noopener"'+st+' data-ssr="hdr">'; closeT='</a>'; }
      else if(cat){ openT='<span class="tag-chip tag-chip--category" data-ssr-cat="1"'+st+'>'; closeT='</span>'; }
      else { openT='<a class="tag-chip" href="'+_escT((alias?'/'+alias:'/'+n.noteId))+'" data-ssr-link="1"'+st+'>'; closeT='</a>'; }
      out+='<li class="tree-item" data-note-id="'+_escT(n.noteId)+'" data-ssr="hdr"><div class="tree-node">';
      out+='<span class="tree-toggle'+(hasKids?'':' tree-toggle--empty')+'">▶</span>';
      out+=openT;
      if(icon) out+='<i class="'+_escT(icon)+'"></i> ';
      out+=_escT(n.title||'');
      out+=closeT;
      out+='</div>';
      if(hasKids){ out+='<ul class="tree-children" style="display:none">'+_build(n)+'</ul>'; }
      out+='</li>';
    }
    return out;
  }
  var root = homeNote || subRoot;
  if(root){
    _countWalk(root, {}, []);
    // 按修改时间倒序，取前 3 生成菜单"最近动态"（与首页模块同口径）
    _UPD_ARR.sort(function(x,y){ return String(y.d).localeCompare(String(x.d)); });
    var _MEGA_N=0;
    for(var _mi=0; _mi<_UPD_ARR.length && _MEGA_N<3; _mi++){ _MEGA_N++; _SSR_MEGA_UPDATES += _megaLi(_UPD_ARR[_mi].n, _UPD_ARR[_mi].d); }
    _SSR_TREE = _build(root, root.noteId);
    var rk=_kids(root), found=null;
    if(rk){ for(var b=0;b<rk.length;b++){ if(rk[b]&&rk[b].title==='关于'){ found=rk[b]; break; } } }
    if(found) _SSR_ABOUT = _build(found, found.noteId);
  }
  // 预生成 JSON（避开构建压缩对 // 注释的误判），并转义可能的 </script>
  _SSR_TAGJSON = JSON.stringify(_SSR_TAGDATA).split('</').join('<\/');
  _SSR_HUBJSON = JSON.stringify(_SSR_HUB).split('</').join('<\/');
  _SSR_SEARCHJSON = JSON.stringify(_SSR_SEARCH).split('</').join('<\/');
})();
%>
<script>window.__SSR_TAGDATA__ = <%- _SSR_TAGJSON %>;window.__SSR_HUB__ = <%- _SSR_HUBJSON %>;window.__SSR_SEARCH__ = <%- _SSR_SEARCHJSON %>;</script>
<header class="header">
  <div class="header-inner">
    <div class="logo-area">
      <img class="logo-icon" src="/logo.icon" alt="" />
      <span class="logo-text"><%= _cfg.blogTitle || 'ZFY' %></span>
    </div>

    <nav class="nav-links">
      <a class="nav-item<%= isHome ? ' active' : '' %>" href="./">首页</a>
      <a class="nav-item category-btn" id="category-btn" href="#">分类</a>
      <div class="nav-item-wrap" id="about-wrap">
        <a class="nav-item" href="#" id="about-btn">关于</a>
        <div class="about-dropdown" id="about-dropdown">
          <ul class="about-menu" id="about-menu"><%- _SSR_ABOUT %></ul>
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <button class="btn-icon" id="search-toggle" aria-label="搜索"><i class="bx bx-search"></i></button>
      <button class="btn-icon" id="theme-toggle" aria-label="切换主题">☀</button>
      <button class="hamburger" id="menu-toggle" aria-label="菜单">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="search-dropdown" id="search-dropdown">
    <div class="search-inner">
        <div class="search-input-wrap">
            <span class="search-input-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
            <input class="search-input" id="search-input" type="text" placeholder="搜索笔记标题或内容…" autocomplete="off" spellcheck="false" />
        </div>
        <div class="search-results" id="search-results"></div>
    </div>
</div>

<div class="mobile-menu" id="mobile-menu">
  <a class="nav-item<%= isHome ? ' active' : '' %>" href="./">首页</a>
  <a class="nav-item category-btn" id="category-btn-mobile" href="#">分类</a>
  <a class="nav-item" id="about-btn-mobile" href="#">关于</a>
  <div class="about-dropdown about-dropdown--mobile" id="about-dropdown-mobile">
    <ul class="about-menu" id="about-menu-mobile"><%- _SSR_ABOUT %></ul>
  </div>
</div>

<div class="category-panel" id="category-panel">
    <div class="cat-mega" id="cat-mega">
        <div class="cat-mega-inner">
            <!-- 左侧：分类树 -->
            <div class="cat-mega-left">
                <div class="cat-mega-label">分类</div>
                <ul class="tree-list" id="tree-list"><%- _SSR_TREE %></ul>
            </div>
            <!-- 右侧：统计简报 + 最近更新 -->
            <div class="cat-mega-right">
                <div class="cat-mega-section">
                    <div class="cat-mega-label">统计</div>
                    <div class="cat-mega-stats stats-dashboard">
                        <a class="stat-pill stat-pill--article<%= _statLink ? '' : ' stat-pill--static' %>" href="<%= _tagListUrl(_st.article) %>" title="查看文章列表">
                            <i class="bx bx-news stat-pill__icon"></i>
                            <span class="stat-pill__label">文章</span>
                            <em class="stat-pill__num" id="cms-article" data-ssr="st"><%= _SSR_STATS.article %></em>
                        </a>
                        <a class="stat-pill stat-pill--update<%= _statLink ? '' : ' stat-pill--static' %>" href="<%= _tagListUrl(_st.recentUpdate) %>" title="查看动态">
                            <i class="bx bx-time-five stat-pill__icon"></i>
                            <span class="stat-pill__label">动态</span>
                            <em class="stat-pill__num" id="cms-update" data-ssr="st"><%= _SSR_STATS.recentUpdate %></em>
                        </a>
                        <a class="stat-pill stat-pill--recommend<%= _statLink ? '' : ' stat-pill--static' %>" href="<%= _tagListUrl(_st.recommend) %>" title="查看推荐阅读">
                            <i class="bx bx-star stat-pill__icon"></i>
                            <span class="stat-pill__label">推荐</span>
                            <em class="stat-pill__num" id="cms-recommend" data-ssr="st"><%= _SSR_STATS.recommend %></em>
                        </a>
                        <a class="stat-pill stat-pill--announce<%= _statLink ? '' : ' stat-pill--static' %>" href="<%= _tagListUrl(_st.announcement) %>" title="查看公告">
                            <i class="bx bx-bell stat-pill__icon"></i>
                            <span class="stat-pill__label">公告</span>
                            <em class="stat-pill__num" id="cms-announce" data-ssr="st"><%= _SSR_STATS.announcement %></em>
                        </a>
                    </div>
                </div>
                <div class="cat-mega-section">
                    <div class="cat-mega-label">最近动态</div>
                    <ul class="cat-mega-updates" id="cms-updates" data-ssr="upd"><% if (_SSR_MEGA_UPDATES) { %><%- _SSR_MEGA_UPDATES %><% } else { %><li class="cat-mega-update-item">暂无动态</li><% } %></ul>
                </div>
            </div>
        </div>
    </div>
</div>

    <% if (isHome) {
    /* ────────────────────────────────────────────────────────────────
       服务端实时聚合（SSR）——替代浏览器 fetch(/blog-data) 的「列表」部分。
       原理：模板在服务端渲染时，从博客根/subRoot 实时遍历笔记树，
       收集 #article / #recentUpdate / #announcement / #recommend 标签的笔记，
       直接生成 HTML，浏览器不再需要预生成的 JSON 快照（改文即见、无手动重建）。
       标题搜索索引（window.__SSR_SEARCH__）与标签云（__SSR_TAGDATA__）亦由模板注入。
       ──────────────────────────────────────────────────────────────── */
    var SSR = { articles:[], updates:[], recommend:[], announcement:null,
                heatmap:{}, heatmapArr:[], hmHTML:'', hmGridStyle:'',
                stats:{ article:0, recentUpdate:0, recommend:0, announcement:0 } };
    try {
        var _seen = {}, _monthStart = 0;
        var _ymd = function(d){ if(!d) return ''; try{ var o=new Date(d); if(!isNaN(o.getTime())) return o.getFullYear()+'-'+String(o.getMonth()+1).padStart(2,'0')+'-'+String(o.getDate()).padStart(2,'0'); }catch(e){} return String(d).slice(0,10); };
        var _esc = function(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&#34;').replace(/'/g,'&#39;'); };
        var _sortD = function(a,b){ return String(b.dateCreated).localeCompare(String(a.dateCreated)); };
        var _url = function(it){ return it.ext ? it.ext : ('/' + (it.alias || it.noteId)); };
        var _TAG_COLORS=['#e74c3c','#e67e22','#f1c40f','#2ecc71','#1abc9c','#3498db','#9b59b6','#e91e63','#00bcd4','#ff5722','#795548','#607d8b','#4caf50','#03a9f4','#cddc39'];
        var _tagH = function(s){ var x=0; for(var i=0;i<s.length;i++) x=((x<<5)-x)+s.charCodeAt(i); return Math.abs(x); };
        var _tagStyle = function(name){ var c=_TAG_COLORS[_tagH(name)%_TAG_COLORS.length]; return 'color:'+c+';--tag-color:'+c; };
        var _bc = function(it){
            if(!it.cat || !it.cat.length) return '';
            var s='<div class="rec-breadcrumb">';
            for(var b=0;b<it.cat.length;b++){ if(b>0) s+='<span class="rec-bc-sep">/</span>'; s+='<a class="rec-bc-link" href="javascript:;" data-cat-id="'+_esc(it.cat[b].noteId)+'">'+_esc(it.cat[b].title)+'</a>'; }
            return s+'</div>';
        };
        var _card = function(it, extraCls, noBc){
            var s='<div class="rec-card-body'+(extraCls?' '+extraCls:'')+'">';
            if(!noBc) s += _bc(it);
            s+='<h4 class="rec-title"><a href="'+_esc(_url(it))+'"';
            if(it.ext) s+=' target="_blank" rel="noopener"';
            if(it.color) s+=' style="color:'+_esc(it.color)+'"';
            s+='>';
            if(it.icon) s+='<i class="'+_esc(it.icon)+' rec-item-icon"></i> ';
            s+=_esc(it.title)+'</a></h4>';
            if(it.tags && it.tags.length){
                s+='<div class="module-tags">';
                for(var _ti=0;_ti<it.tags.length;_ti++){ s+='<span class="tag-chip tag-chip--note" data-tag="'+_esc(it.tags[_ti])+'" style="'+_tagStyle(it.tags[_ti])+'"><i class="bx bx-purchase-tag-alt"></i> '+_esc(it.tags[_ti])+'</span>'; }
                s+='</div>';
            }
            if(it.dateCreated) s+='<div class="rec-meta"><time class="rec-date">'+_esc(_ymd(it.dateCreated))+'</time></div>';
            s+='</div>';
            return s;
        };
        var _walk = function(n){
            if(!n) return;
            var id = n.noteId;
            if(!id) return;
            if(_seen[id]) return;
            _seen[id] = true;
            var h = function(name){ try{ var _at=n.ownedAttributes; if(_at){ for(var _i2=0;_i2<_at.length;_i2++){ var _aa=_at[_i2]; if(_aa && _aa.type==='label' && _aa.name===name){ var _vv=_aa.value; if(_vv===undefined||_vv===null||_vv===''||_vv==='true') return true; } } return false; } }catch(e){} return false; };
            var g = function(name){ try{ return n.getLabelValue ? (n.getLabelValue(name)||'') : ''; }catch(e){ return ''; } };
            var isArticle=h('article'), isUpdate=h('recentUpdate'), isAnn=h('announcement'), isRec=h('recommend');
            if(isArticle || isUpdate || isAnn || isRec){
                var _tg=[];
                try{ var _at=n.ownedAttributes; if(_at){ for(var _ai=0;_ai<_at.length;_ai++){ if(_at[_ai]&&_at[_ai].type==='label'&&_at[_ai].name==='noteTag'&&_at[_ai].value) _tg.push(_at[_ai].value); } } }catch(e){}
                if(!_tg.length){ var _gv = (function(){ try{ return n.getLabelValue ? (n.getLabelValue('noteTag')||'') : ''; }catch(e){ return ''; } })(); if(_gv) _tg=[_gv]; }
                var it = { noteId:id, title:n.title||'', alias:g('shareAlias'), ext:g('shareExternalLink'),
                           icon:g('icon')||g('iconClass'), color:g('color'), dateCreated:(_blogCreated(n) || n.utcDateModified)||'', tags:_tg,
                           cover:_blogCover(n),
                           cat:(_SSR_CATPATH[id]||[]) };
                if(isAnn && !SSR.announcement) SSR.announcement = it;
                if(isUpdate) SSR.updates.push(it);
                if(isRec) SSR.recommend.push(it);
                if(isArticle) SSR.articles.push(it);
            }
            /* 热力图口径与原脚本一致：按「全部笔记的修改日期」逐日计数（修订创建不重复计入） */
            var _nd = n.utcDateModified || n.dateCreated;
            if(_nd){ var _d=_ymd(_nd); SSR.heatmap[_d]=(SSR.heatmap[_d]||0)+1; }
            var kids=null; try{ kids=n.getChildNotes(); }catch(e){}
            if(kids) for(var i=0;i<kids.length;i++) _walk(kids[i]);
        };
        var _callArg = homeNote || subRoot;
        _walk(_callArg);
        SSR.articles.sort(_sortD); SSR.updates.sort(_sortD); SSR.recommend.sort(_sortD);
        SSR.stats = { article:SSR.articles.length, recentUpdate:SSR.updates.length, recommend:SSR.recommend.length, announcement:SSR.announcement?1:0 };
        var _hk = Object.keys(SSR.heatmap), _hmMax = 1;
        for(var _x=0;_x<_hk.length;_x++){ SSR.heatmapArr.push({date:_hk[_x], count:SSR.heatmap[_hk[_x]]}); if(SSR.heatmap[_hk[_x]]>_hmMax) _hmMax=SSR.heatmap[_hk[_x]]; }
        /* ---- 热力图（复刻 renderHeatmap 算法，窗口放宽到整站历史）---- */
        var now=new Date(); now.setHours(0,0,0,0);
        /* 访客本地日期可能早于服务器（如 UTC+8 用户在服务器仍是前一天），向后多看一天，保证热力图覆盖访客"今天" */
        now.setDate(now.getDate()+1);
        var hmStart=new Date(now); hmStart.setDate(hmStart.getDate()-363);
        var _hmKeys=Object.keys(SSR.heatmap).filter(function(k){ return /^\d{4}-\d{2}-\d{2}$/.test(k); });
        if(_hmKeys.length){
            _hmKeys.sort();
            var _earliest=new Date(_hmKeys[0]);
            if(!isNaN(_earliest.getTime()) && _earliest<now){
                var _wide=new Date(_earliest); _wide.setDate(_wide.getDate()-363);
                if(_wide<hmStart) hmStart=_wide;
            }
        }
        while(hmStart.getDay()!==1) hmStart.setDate(hmStart.getDate()-1);
        var cur=new Date(hmStart), prevMonth=-1, hmWeeks=[], hmMonths=[];
        while(cur<=now){
            if(cur.getMonth()!==prevMonth){ if(prevMonth!==-1) hmMonths.push({label:(prevMonth+1)+'月', start:_monthStart, span:hmWeeks.length-_monthStart}); prevMonth=cur.getMonth(); _monthStart=hmWeeks.length; }
            var week=[];
            for(var dd=0;dd<7;dd++){
                var key=cur.getFullYear()+'-'+String(cur.getMonth()+1).padStart(2,'0')+'-'+String(cur.getDate()).padStart(2,'0');
                week.push({date:key, count:SSR.heatmap[key]||0, future:cur>now});
                cur.setDate(cur.getDate()+1);
            }
            hmWeeks.push(week);
        }
        if(prevMonth!==-1) hmMonths.push({label:(prevMonth+1)+'月', start:_monthStart, span:hmWeeks.length-_monthStart});
        SSR.hmGridStyle = 'grid-template-columns:28px repeat('+hmWeeks.length+',13px);grid-template-rows:18px repeat(7,13px);';
        var hmHTML='';
        for(var mi=0;mi<hmMonths.length;mi++){ var mo=hmMonths[mi]; hmHTML+='<div class="hm-month" style="grid-column:'+(2+mo.start)+' / span '+mo.span+';grid-row:1">'+_esc(mo.label)+'</div>'; }
        var wdays=['一','二','三','四','五','六','日'];
        for(var di=0;di<7;di++){
            hmHTML+='<div class="hm-wday" style="grid-column:1;grid-row:'+(di+2)+'">'+wdays[di]+'</div>';
            for(var wi=0;wi<hmWeeks.length;wi++){
                var cell=hmWeeks[wi][di], lvl=0;
                if(cell.count>0){ lvl=Math.ceil((cell.count/_hmMax)*4); if(lvl<1)lvl=1; if(lvl>4)lvl=4; }
                var cls=cell.future?'hm-future':'hm-cell hm-l'+lvl;
                var _hmA = cell.future ? '' : ' role="button" tabindex="0"';
                hmHTML+='<div class="'+cls+'" style="grid-column:'+(wi+2)+';grid-row:'+(di+2)+'" data-date="'+cell.date+'" data-count="'+cell.count+'"'+_hmA+'></div>';
            }
        }
        SSR.hmHTML = hmHTML;
    } catch(_e) { SSR.articles = []; SSR.updates = []; }
    SSR.articlesJSON = JSON.stringify(SSR.articles).split('</').join('<\/');
    %>
<script>window.__SSR_HOME__ = true;window.__SSR_ARTICLES__ = <%- SSR.articlesJSON %>;</script>
