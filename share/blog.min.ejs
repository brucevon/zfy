<% var HOME_ID = '';var homeNote = null;try { var _cur = note;for (var _d = 0;_d < 50;_d++) { if (_cur.hasLabel && _cur.hasLabel('isHome') && _cur.getLabelValue('isHome') === 'true') { homeNote = _cur;HOME_ID = _cur.noteId;break;} var _parents = _cur.getParentNotes();if (!_parents || !_parents.length) break;_cur = _parents[0];} } catch(_e) {} var isHome = note.noteId === HOME_ID;var _cfg = {};if (homeNote) { function _cfgVal(name, def) { try { var v = homeNote.getLabelValue(name);return v || def;} catch(_) { return def;} } _cfg.homeId = HOME_ID;_cfg.isHome = isHome;_cfg.defaultTheme = _cfgVal('appearanceDefaultTheme', 'dark');_cfg.twikooEnabled = _cfgVal('twikooEnabled') === 'true';_cfg.twikooEnvId = _cfgVal('twikooEnvId', '');_cfg.defaultCover = _cfgVal('coverDefaultImage', '/bg-pc.png');_cfg.coverMobileImage = _cfgVal('coverMobileImage', '/bg-mobile.png');_cfg.blogTitle = _cfgVal('blogTitle', '');_cfg.blogDescription = _cfgVal('blogDescription', '');_cfg.footerCopyright = _cfgVal('footerCopyright', '');_cfg.footerIcp = _cfgVal('footerIcp', '');_cfg.footerPolice = _cfgVal('footerPolice', '');_cfg.footerPoliceUrl = _cfgVal('footerPoliceUrl', '');_cfg.footerBeianIcon = _cfgVal('footerBeianIcon', '/beian.png');_cfg.siteStartDate = _cfgVal('siteStartDate', '');_cfg.twikooVersion = _cfgVal('twikooVersion', '1.6.41');_cfg.tagCloudIconClass = _cfgVal('tagCloudIconClass', 'bx bx-purchase-tag-alt');_cfg.tagCloudNoteId = '';try { if (note.hasLabel && note.hasLabel('tagCloud')) { _cfg.tagCloudNoteId = note.noteId;try { var _tci = note.getLabelValue('tagCloudIconClass');if (_tci) _cfg.tagCloudIconClass = _tci;} catch(_e) {} } else if (homeNote) { var _kids = homeNote.getChildNotes();if (_kids) for (var _k = 0;_k < _kids.length;_k++) { if (_kids[_k].hasLabel && _kids[_k].hasLabel('tagCloud')) { _cfg.tagCloudNoteId = _kids[_k].noteId;break;} } } } catch(_e) {} _cfg.statTags = { recommend: _cfgVal('statTagRecommend', '推荐阅读'), article: _cfgVal('statTagArticle', '文章'), recentUpdate: _cfgVal('statTagUpdate', '动态'), announcement: _cfgVal('statTagAnnounce', '公告') };} var _noteIconCls = '';try { _noteIconCls = note.getLabelValue('icon') || note.getLabelValue('iconClass') || '';} catch(_e) {} if (_noteIconCls) _cfg.noteIcon = _noteIconCls;var _pageDesc = '';try { _pageDesc = note.getLabelValue('blogDescription') || _cfg.blogDescription || '';} catch(_e) { _pageDesc = _cfg.blogDescription || '';} function _tagListUrl(tag) { if (!_cfg.tagCloudNoteId || !tag) return '#';return '/' + _cfg.tagCloudNoteId + '?tag=' + encodeURIComponent(tag);} var _st = _cfg.statTags || { recommend: '推荐阅读', article: '文章', recentUpdate: '动态', announcement: '公告' };var _statLink = !!_cfg.tagCloudNoteId; %>
