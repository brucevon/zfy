<%
// 服务端构建分类树，内嵌到页面供 blog.js 使用
function buildCategoryTree(parentNote) {
    var result = [];
    var kids;
    try { kids = parentNote.getChildNotes(); } catch(e) { return result; }
    if (!kids || !kids.length) return result;
    for (var ci = 0; ci < kids.length; ci++) {
        var kid = kids[ci];
        // 跳过 shareHiddenFromTree 标签的笔记
        try { if (kid.hasLabel && kid.hasLabel('shareHiddenFromTree') && kid.getLabelValue('shareHiddenFromTree') === 'true') continue; } catch(e) {}
        var isCat = false;
        try { isCat = !!(kid.getLabelValue && kid.getLabelValue('category') === 'true'); } catch(e) {}
        var icon = '';
        try {
            icon = kid.getLabelValue ? kid.getLabelValue('iconClass') || '' : '';
        } catch(e) {}
        var node = { noteId: kid.noteId, title: kid.title, category: isCat, children: [] };
        if (icon) node.icon = icon;
        node.children = buildCategoryTree(kid);
        result.push(node);
    }
    return result;
}
var _catTree = [];
try {
    var rootNote = homeNote || note;
    _catTree = buildCategoryTree(rootNote);
} catch(e) { _catTree = []; }
%>
<script>window.__CATEGORY_TREE__ = <%- JSON.stringify(_catTree) %>;</script>

<%
// 服务端查找"关于"笔记，构建下拉菜单树
var _aboutTree = [];
try {
    (function findAbout(n) {
        if (n.title === '关于') {
            _aboutTree = buildCategoryTree(n);
        } else {
            var ks;
            try { ks = n.getChildNotes(); } catch(e) { ks = []; }
            for (var fi = 0; fi < ks.length; fi++) {
                if (_aboutTree.length) break;
                findAbout(ks[fi]);
            }
        }
    })(rootNote || note);
} catch(e) {}
%>
<script>window.__ABOUT_MENU__ = <%- JSON.stringify(_aboutTree) %>;</script>
